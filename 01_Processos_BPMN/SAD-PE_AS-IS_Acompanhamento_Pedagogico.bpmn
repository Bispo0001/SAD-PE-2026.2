<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_SADPE_ASIS" targetNamespace="http://sad-pe.ifs.edu.br/bpmn/as-is" exporter="Claude" exporterVersion="1.0">
  <bpmn:message id="Msg1" name="Pedido de ajuda" />
  <bpmn:message id="Msg2" name="Comunicação de saída" />
  <bpmn:message id="Msg3" name="Contato com a família" />
  <bpmn:message id="Msg4" name="Convite às ações de apoio" />
  <bpmn:dataStore id="DS_Academico" name="Sistema acadêmico" />
  <bpmn:collaboration id="Collab_ASIS">
    <bpmn:participant id="Part_Inst" name="Campus Aracaju: acompanhamento pedagógico (AS-IS)" processRef="Proc_Inst" />
    <bpmn:participant id="Part_Est" name="Estudante e família" processRef="Proc_Est" />
    <bpmn:messageFlow id="MF1" name="Pedido de ajuda" sourceRef="TE1" targetRef="MS1" messageRef="Msg1" />
    <bpmn:messageFlow id="MF2" name="Comunicação de saída" sourceRef="TE2" targetRef="MS2" messageRef="Msg2" />
    <bpmn:messageFlow id="MF3" name="Contato com a família" sourceRef="T14" targetRef="MSF" messageRef="Msg3" />
    <bpmn:messageFlow id="MF4" name="Convite às ações de apoio" sourceRef="T17" targetRef="MSE" messageRef="Msg4" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Inst" isExecutable="false">
    <bpmn:laneSet id="LS_I">
      <bpmn:lane id="L_R" name="Professor da disciplina">
        <bpmn:flowNodeRef>S0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_C" name="Coordenação do curso integrado">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T18</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_D" name="Direção / Gerência de Ensino">
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_A" name="Assistência estudantil e núcleo especializado">
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_P" name="Setor pedagógico">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MS1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MS2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S0" name="Início de cada bimestre (4 por ano)"><bpmn:timerEventDefinition id="TD_S0" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="M0" />
    <bpmn:task id="T1" name="Aplicar avaliação bimestral" />
    <bpmn:task id="T2" name="Lançar notas e faltas no sistema acadêmico">
      <bpmn:dataOutputAssociation id="DOA1"><bpmn:targetRef>DSR1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Resultado suficiente?" />
    <bpmn:task id="T3" name="Aplicar recuperação bimestral e lançar nota" />
    <bpmn:exclusiveGateway id="M1" />
    <bpmn:task id="T4" name="Observar desempenho e participação em sala" />
    <bpmn:exclusiveGateway id="G2" name="Dificuldade percebida em sala?" />
    <bpmn:task id="T5" name="Relatar dificuldade à coordenação ou pedagogia" />
    <bpmn:task id="T6" name="Analisar notas, faltas e relatos">
      <bpmn:property id="Prop_T6" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA1"><bpmn:sourceRef>DSR2</bpmn:sourceRef><bpmn:targetRef>Prop_T6</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="Dificuldade percebida pela coordenação?" />
    <bpmn:task id="T7" name="Analisar notas, faltas e relatos">
      <bpmn:property id="Prop_T7" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA2"><bpmn:sourceRef>DSR3</bpmn:sourceRef><bpmn:targetRef>Prop_T7</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G4" name="Dificuldade percebida pela pedagogia?" />
    <bpmn:startEvent id="MS1" name="Pedido de ajuda recebido"><bpmn:messageEventDefinition id="MD_MS1" messageRef="Msg1" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="M2" />
    <bpmn:task id="T8" name="Acolher o caso e compreender a dificuldade" />
    <bpmn:exclusiveGateway id="G5" name="Dificuldade geral ou individual?" />
    <bpmn:task id="T9" name="Convocar e conduzir conselho de classe" />
    <bpmn:subProcess id="SP1" name="Realizar conselho de classe">
      <bpmn:startEvent id="SP1_S" name="Conselho convocado" />
      <bpmn:task id="SP1_T1" name="Analisar coletivamente a turma ou disciplina" />
      <bpmn:task id="SP1_T2" name="Definir encaminhamentos coletivos" />
      <bpmn:endEvent id="SP1_E" name="Encaminhamentos registrados" />
      <bpmn:sequenceFlow id="F_SP1_S_SP1_T1" sourceRef="SP1_S" targetRef="SP1_T1" />
      <bpmn:sequenceFlow id="F_SP1_T1_SP1_T2" sourceRef="SP1_T1" targetRef="SP1_T2" />
      <bpmn:sequenceFlow id="F_SP1_T2_SP1_E" sourceRef="SP1_T2" targetRef="SP1_E" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="G6" name="Decisão estrutural necessária?" />
    <bpmn:task id="T10" name="Tomar decisão estrutural" />
    <bpmn:exclusiveGateway id="M3" />
    <bpmn:task id="T11" name="Avaliar necessidades do estudante" />
    <bpmn:task id="T12" name="Definir intervenção com professor e coordenação" />
    <bpmn:inclusiveGateway id="I1" name="Quais ações?" default="F_I1_T13" />
    <bpmn:task id="T13" name="Orientar estudos e acompanhar (inclui mentoria por pares)" />
    <bpmn:task id="T14" name="Contatar a família" />
    <bpmn:task id="T15" name="Prestar apoio social, psicológico ou especializado" />
    <bpmn:task id="T16" name="Realizar recuperação paralela ou apoio pedagógico" />
    <bpmn:inclusiveGateway id="I2" />
    <bpmn:task id="T17" name="Acompanhar estudante e família" />
    <bpmn:exclusiveGateway id="G7" name="Houve evolução?" />
    <bpmn:exclusiveGateway id="M5" />
    <bpmn:exclusiveGateway id="G8" name="Último bimestre do ano?" />
    <bpmn:task id="T18" name="Avaliar situação do estudante ao fim do ano letivo" />
    <bpmn:exclusiveGateway id="G9" name="Situação ao fim do ano?" />
    <bpmn:endEvent id="E1" name="Estudante aprovado" />
    <bpmn:endEvent id="E2" name="Estudante retido (repete a série)" />
    <bpmn:endEvent id="E3" name="Estudante fora do curso" />
    <bpmn:startEvent id="MS2" name="Saída comunicada (a qualquer momento do ano)"><bpmn:messageEventDefinition id="MD_MS2" messageRef="Msg2" /></bpmn:startEvent>
    <bpmn:task id="T19" name="Registrar saída do estudante" />
    <bpmn:endEvent id="E4" name="Estudante fora do curso" />
    <bpmn:dataStoreReference id="DSR1" name="Sistema acadêmico" dataStoreRef="DS_Academico" />
    <bpmn:dataStoreReference id="DSR2" name="Sistema acadêmico" dataStoreRef="DS_Academico" />
    <bpmn:dataStoreReference id="DSR3" name="Sistema acadêmico" dataStoreRef="DS_Academico" />
    <bpmn:sequenceFlow id="F_S0_M0" sourceRef="S0" targetRef="M0" />
    <bpmn:sequenceFlow id="F_M0_T1" sourceRef="M0" targetRef="T1" />
    <bpmn:sequenceFlow id="F_T1_T2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F_T2_G1" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="F_G1_T3" name="Não" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="F_G1_M1" name="Sim" sourceRef="G1" targetRef="M1" />
    <bpmn:sequenceFlow id="F_T3_M1" sourceRef="T3" targetRef="M1" />
    <bpmn:sequenceFlow id="F_M1_T4" sourceRef="M1" targetRef="T4" />
    <bpmn:sequenceFlow id="F_T4_G2" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="F_G2_T5" name="Sim" sourceRef="G2" targetRef="T5" />
    <bpmn:sequenceFlow id="F_G2_T6" name="Não" sourceRef="G2" targetRef="T6" />
    <bpmn:sequenceFlow id="F_T5_M2" sourceRef="T5" targetRef="M2" />
    <bpmn:sequenceFlow id="F_T6_G3" sourceRef="T6" targetRef="G3" />
    <bpmn:sequenceFlow id="F_G3_M2" name="Sim" sourceRef="G3" targetRef="M2" />
    <bpmn:sequenceFlow id="F_G3_T7" name="Não" sourceRef="G3" targetRef="T7" />
    <bpmn:sequenceFlow id="F_T7_G4" sourceRef="T7" targetRef="G4" />
    <bpmn:sequenceFlow id="F_G4_M2" name="Sim" sourceRef="G4" targetRef="M2" />
    <bpmn:sequenceFlow id="F_G4_M5" name="Não" sourceRef="G4" targetRef="M5" />
    <bpmn:sequenceFlow id="F_MS1_M2" sourceRef="MS1" targetRef="M2" />
    <bpmn:sequenceFlow id="F_M2_T8" sourceRef="M2" targetRef="T8" />
    <bpmn:sequenceFlow id="F_T8_G5" sourceRef="T8" targetRef="G5" />
    <bpmn:sequenceFlow id="F_G5_T9" name="Geral" sourceRef="G5" targetRef="T9" />
    <bpmn:sequenceFlow id="F_T9_SP1" sourceRef="T9" targetRef="SP1" />
    <bpmn:sequenceFlow id="F_SP1_G6" sourceRef="SP1" targetRef="G6" />
    <bpmn:sequenceFlow id="F_G6_T10" name="Sim" sourceRef="G6" targetRef="T10" />
    <bpmn:sequenceFlow id="F_G6_M3" name="Não" sourceRef="G6" targetRef="M3" />
    <bpmn:sequenceFlow id="F_T10_M3" sourceRef="T10" targetRef="M3" />
    <bpmn:sequenceFlow id="F_M3_M5" sourceRef="M3" targetRef="M5" />
    <bpmn:sequenceFlow id="F_G5_T11" name="Individual" sourceRef="G5" targetRef="T11" />
    <bpmn:sequenceFlow id="F_T11_T12" sourceRef="T11" targetRef="T12" />
    <bpmn:sequenceFlow id="F_T12_I1" sourceRef="T12" targetRef="I1" />
    <bpmn:sequenceFlow id="F_I1_T13" name="Orientação / mentoria" sourceRef="I1" targetRef="T13" />
    <bpmn:sequenceFlow id="F_I1_T14" name="Família" sourceRef="I1" targetRef="T14"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${contatarFamilia}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_I1_T15" name="Apoio especializado" sourceRef="I1" targetRef="T15"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${apoioEspecializado}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_I1_T16" name="Recuperação paralela" sourceRef="I1" targetRef="T16"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${recuperacaoParalela}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_T13_I2" sourceRef="T13" targetRef="I2" />
    <bpmn:sequenceFlow id="F_T14_I2" sourceRef="T14" targetRef="I2" />
    <bpmn:sequenceFlow id="F_T15_I2" sourceRef="T15" targetRef="I2" />
    <bpmn:sequenceFlow id="F_T16_I2" sourceRef="T16" targetRef="I2" />
    <bpmn:sequenceFlow id="F_I2_T17" sourceRef="I2" targetRef="T17" />
    <bpmn:sequenceFlow id="F_T17_G7" sourceRef="T17" targetRef="G7" />
    <bpmn:sequenceFlow id="F_G7_T12" name="Não: rever intervenção" sourceRef="G7" targetRef="T12" />
    <bpmn:sequenceFlow id="F_G7_M5" name="Sim" sourceRef="G7" targetRef="M5" />
    <bpmn:sequenceFlow id="F_M5_G8" sourceRef="M5" targetRef="G8" />
    <bpmn:sequenceFlow id="F_G8_M0" name="Não: próximo bimestre" sourceRef="G8" targetRef="M0" />
    <bpmn:sequenceFlow id="F_G8_T18" name="Sim" sourceRef="G8" targetRef="T18" />
    <bpmn:sequenceFlow id="F_T18_G9" sourceRef="T18" targetRef="G9" />
    <bpmn:sequenceFlow id="F_G9_E1" name="Aprovado" sourceRef="G9" targetRef="E1" />
    <bpmn:sequenceFlow id="F_G9_E2" name="Retido" sourceRef="G9" targetRef="E2" />
    <bpmn:sequenceFlow id="F_G9_E3" name="Fora do curso" sourceRef="G9" targetRef="E3" />
    <bpmn:sequenceFlow id="F_MS2_T19" sourceRef="MS2" targetRef="T19" />
    <bpmn:sequenceFlow id="F_T19_E4" sourceRef="T19" targetRef="E4" />
    <bpmn:textAnnotation id="A1"><bpmn:text>Ponto de dor: não há critério formal para definir dificuldade; a percepção depende de quem observa e de quando observa.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A2"><bpmn:text>A validar: quem registra e cobra cada encaminhamento.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A3"><bpmn:text>ROD: não há dependência nos integrados. Critérios de retenção e desligamento: confirmar no ROD.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="AS1" sourceRef="T6" targetRef="A1" />
    <bpmn:association id="AS2" sourceRef="T17" targetRef="A2" />
    <bpmn:association id="AS3" sourceRef="T18" targetRef="A3" />
  </bpmn:process>
  <bpmn:process id="Proc_Est" isExecutable="false">
    <bpmn:laneSet id="LS_E">
      <bpmn:lane id="L_E" name="Estudante">
        <bpmn:flowNodeRef>SE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SE2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TE2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TE3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_F" name="Família">
        <bpmn:flowNodeRef>MSF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TF1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EF1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SE1" name="Resultado da avaliação conhecido" />
    <bpmn:task id="TE1" name="Procurar ajuda no setor pedagógico ou na coordenação" />
    <bpmn:endEvent id="EE1" name="Pedido enviado" />
    <bpmn:startEvent id="SE2" name="Decide deixar o curso" />
    <bpmn:task id="TE2" name="Comunicar saída do curso" />
    <bpmn:endEvent id="EE2" name="Saída comunicada" />
    <bpmn:startEvent id="MSE" name="Convite às ações de apoio recebido"><bpmn:messageEventDefinition id="MD_MSE" messageRef="Msg4" /></bpmn:startEvent>
    <bpmn:task id="TE3" name="Participar das ações de apoio" />
    <bpmn:endEvent id="EE3" name="Ações concluídas" />
    <bpmn:startEvent id="MSF" name="Contato da pedagogia recebido"><bpmn:messageEventDefinition id="MD_MSF" messageRef="Msg3" /></bpmn:startEvent>
    <bpmn:task id="TF1" name="Acompanhar o estudante e apoiar a intervenção" />
    <bpmn:endEvent id="EF1" name="Acompanhamento da família" />
    <bpmn:sequenceFlow id="F_SE1_TE1" sourceRef="SE1" targetRef="TE1" />
    <bpmn:sequenceFlow id="F_TE1_EE1" sourceRef="TE1" targetRef="EE1" />
    <bpmn:sequenceFlow id="F_SE2_TE2" sourceRef="SE2" targetRef="TE2" />
    <bpmn:sequenceFlow id="F_TE2_EE2" sourceRef="TE2" targetRef="EE2" />
    <bpmn:sequenceFlow id="F_MSE_TE3" sourceRef="MSE" targetRef="TE3" />
    <bpmn:sequenceFlow id="F_TE3_EE3" sourceRef="TE3" targetRef="EE3" />
    <bpmn:sequenceFlow id="F_MSF_TF1" sourceRef="MSF" targetRef="TF1" />
    <bpmn:sequenceFlow id="F_TF1_EF1" sourceRef="TF1" targetRef="EF1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ASIS"><bpmndi:BPMNPlane id="Plane_ASIS" bpmnElement="Collab_ASIS">
    <bpmndi:BPMNShape id="Part_Inst_di" bpmnElement="Part_Inst" isHorizontal="true"><dc:Bounds x="40" y="40" width="3900" height="850" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_R_di" bpmnElement="L_R" isHorizontal="true"><dc:Bounds x="70" y="40" width="3870" height="150" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_C_di" bpmnElement="L_C" isHorizontal="true"><dc:Bounds x="70" y="190" width="3870" height="150" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_D_di" bpmnElement="L_D" isHorizontal="true"><dc:Bounds x="70" y="340" width="3870" height="150" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_A_di" bpmnElement="L_A" isHorizontal="true"><dc:Bounds x="70" y="490" width="3870" height="150" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_P_di" bpmnElement="L_P" isHorizontal="true"><dc:Bounds x="70" y="640" width="3870" height="250" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Part_Est_di" bpmnElement="Part_Est" isHorizontal="true"><dc:Bounds x="40" y="950" width="3900" height="280" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_E_di" bpmnElement="L_E" isHorizontal="true"><dc:Bounds x="70" y="950" width="3870" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_F_di" bpmnElement="L_F" isHorizontal="true"><dc:Bounds x="70" y="1090" width="3870" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S0_di" bpmnElement="S0"><dc:Bounds x="132" y="97" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="95" y="135" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="M0_di" bpmnElement="M0" isMarkerVisible="true"><dc:Bounds x="205" y="90" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="290" y="75" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="430" y="75" width="100" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="585" y="90" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="545" y="60" width="130" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
